<?xml version="1.0"?>

<tryton>
    <data>

        <record model="ir.ui.view" id="cirugia_view_form">
            <field name="model">hnap.form_cirugia</field>
            <field name="type">form</field>
            <field name="name">cirugia_form</field>
        </record>
        <record model="ir.ui.view" id="cirugia_view_tree">
            <field name="model">hnap.form_cirugia</field>
            <field name="type">tree</field>
            <field name="name">cirugia_tree</field>
        </record>

        <record model="ir.ui.view" id="cirugia_line_view_form">
            <field name="model">hnap.form_cirugia.line</field>
            <field name="type">form</field>
            <field name="name">cirugia_line_form</field>
        </record>
        <record model="ir.ui.view" id="cirugia_line_view_tree">
            <field name="model">hnap.form_cirugia.line</field>
            <field name="type">tree</field>
            <field name="name">cirugia_line_tree</field>
        </record>

        <!-- acciones -->
        <record model="ir.action.act_window" id="act_cirugia">
            <field name="name">Solisitud de estudios/cirugias</field>
            <field name="res_model">hnap.form_cirugia</field>
            <field name="domain" eval="" pyson="1"/>
        </record>
        <record model="ir.action.act_window.view" id="act_cirugia_tree_view">
            <field name="sequence" eval="10"/>
            <field name="view" ref="cirugia_view_tree"/>
            <field name="act_window" ref="act_cirugia"/>
        </record>
        <record model="ir.action.act_window.view" id="act_cirugia_form_view">
            <field name="sequence" eval="20"/>
            <field name="view" ref="cirugia_view_form"/>
            <field name="act_window" ref="act_cirugia"/>
        </record>

       <menuitem
           sequence="100"
           action="act_cirugia"
           id="menu_act_cirugia"/>
       <record model="ir.ui.menu-res.group" id="act_cirugia_group_admin">
          <field name="menu" ref="menu_act_cirugia"/>
          <field name="group" ref="res.group_admin"/>
       </record> 
       <record model="ir.ui.menu-res.group" id="act_cirugia_group_form_cirugia">
          <field name="menu" ref="menu_act_cirugia"/>
          <field name="group" ref="group_form_cirugia"/>
       </record> 

        <!-- botones -->

        <record model="ir.model.button" id="aprobar_button">
            <field name="name">aprobar</field>
            <field name="string">Aprobar</field>
            <field name="model" search="[('model', '=', 'hnap.form_cirugia')]"/>
        </record>
        <record model="ir.model.button" id="aprobar2_button">
            <field name="name">aprobar2</field>
            <field name="string">Aprobar</field>
            <field name="model" search="[('model', '=', 'hnap.form_cirugia')]"/>
        </record>
        <record model="ir.model.button" id="no_aprobar_button">
            <field name="name">no_aprobar</field>
            <field name="string">No Aprobar</field>
            <field name="model" search="[('model', '=', 'hnap.form_cirugia')]"/>
        </record>
        <record model="ir.model.button" id="finalizar_button">
            <field name="name">finalizar</field>
            <field name="string">Finalizar</field>
            <field name="model" search="[('model', '=', 'hnap.form_cirugia')]"/>
        </record>

        <record model="ir.model.button-res.group"
            id="aprobar_button_group_aprobador_form_cirugia">
            <field name="button" ref="aprobar_button"/>
            <field name="group" ref="group_aprobador_form_cirugia"/>
        </record>
        <record model="ir.model.button-res.group"
            id="aprobar2_button_group_admin_form_cirugia">
            <field name="button" ref="aprobar2_button"/>
            <field name="group" ref="group_admin_form_cirugia"/>
        </record>
        <record model="ir.model.button-res.group"
            id="group_admin_form_cirugia_cerrar_button">
            <field name="button" ref="no_aprobar_button"/>
            <field name="group" ref="group_admin_form_cirugia"/>
        </record>
        <record model="ir.model.button-res.group"
            id="finalizar_button_group_admin_form_cirugia">
            <field name="button" ref="finalizar_button"/>
            <field name="group" ref="group_admin_form_cirugia"/>
        </record>

    <!-- wizards -->

        <record model="ir.action.wizard" id="wiz_change_state_form_cirugia">
            <field name="name">Update State</field>
            <field name="wiz_name">hnap.change_state.form_cirugia</field>
        </record>

    </data>
</tryton>
