<?xml version="1.0"?>
<form col="6">
    <notebook colspan="6">
        <page string="General" id="general">
            <group col="6" colspan="5" id="header" yalign="0">
                <label name="code"/>
                <field name="code"/>
                <label name="date"/>
                <field name="date" widget="date"/>
                <group col="-1" colspan="2" id="checkboxes">
                    <label name="insumos"/>
                    <field name="insumos" xexpand="0" width="25"/>
                    <label name="internado"/>
                    <field name="internado" xexpand="0" width="25"/>
                    <newline/>
                    <label name="estudios"/>
                    <field name="estudios" xexpand="0" width="25"/>
                    <label name="ambulatorio"/>
                    <field name="ambulatorio" xexpand="0" width="25"/>
                </group>
            </group>
            <group colspan="6" id="body" string="Completar por sector solicitante">
                <label name="name"/>
                <field name="name" xexpand="1"/>
                <label name="dni"/>
                <field name="dni"/>
                <label name="date_of_birth"/>
                <field name="date_of_birth" widget="date"/>
                <label name="age"/>
                <field name="age"/>
                <label name="telefono"/>
                <field name="telefono"/>
                <label name="correo"/>
                <field name="correo"/>
                <label name="nro_historia_clinica"/>
                <field name="nro_historia_clinica"/>
                <label name="piso"/>
                <field name="piso"/>
                <label name="cama"/>
                <field name="cama"/>
                <newline/>
                <label name="os"/>
                <field name="os"/>
                <label name="os_name"/>
                <field name="os_name"/>
                <label name="diagnostico"/>
                <field name="diagnostico"/>
                <label name="solisitud"/>
                <field name="solisitud"/>
                <newline/>
                <label name="historia_clinica"/>
                <newline/>
                <field name="historia_clinica" colspan="6"/>
                <label name="observaciones"/>
                <newline/>
                <field name="observaciones" colspan="6"/>
            </group>
        </page>
        <page string="Aprobadores" id="aprobadores">
            <field name="lines"/>
        </page>
    </notebook>
    <group col="8" colspan="6" id="body">
        <label name="user"/>
        <field name="user"/>
        <button name="aprobar"/>
        <button name="aprobar2"/>
        <button name="no_aprobar"/>
        <button name="finalizar"/>
        <label name="state"/>
        <field name="state"/>
    </group>
    <field name="aprobacion_final" invisible="1"/>
</form>
