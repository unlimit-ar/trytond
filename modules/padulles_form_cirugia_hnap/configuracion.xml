<?xml version="1.0" encoding="utf-8"?>
<tryton>
    <data>

        <record model="res.group" id="group_form_cirugia">
            <field name="name">Cirugia</field>
        </record>
        <record model="res.group" id="group_aprobador_form_cirugia">
            <field name="name">Aprobador de Seccion Cirugia</field>
            <field name="parent" ref="group_form_cirugia"/>
        </record>
        <record model="res.group" id="group_admin_form_cirugia">
            <field name="name">Aprobador Total Cirugia</field>
            <field name="parent" ref="group_form_cirugia"/>
        </record>

        <record model="res.user-res.group" id="user_admin_group_form_cirugia">
            <field name="user" ref="res.user_admin"/>
            <field name="group" ref="group_form_cirugia"/>
        </record>
        <record model="res.user-res.group" id="user_admin_group_aprobador_form_cirugia">
            <field name="user" ref="res.user_admin"/>
            <field name="group" ref="group_aprobador_form_cirugia"/>
        </record>
        <record model="res.user-res.group" id="user_admin_group_admin_form_cirugia">
            <field name="user" ref="res.user_admin"/>
            <field name="group" ref="group_admin_form_cirugia"/>
        </record>

    <!-- permisos -->

        <record model="ir.model.access" id="access_form_cirugia">
            <field name="model" search="[('model', '=', 'hnap.form_cirugia')]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_form_cirugia_group_form_cirugia">
            <field name="model" search="[('model', '=', 'hnap.form_cirugia')]"/>
            <field name="group" ref="group_form_cirugia"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_form_cirugia_line">
            <field name="model" search="[('model', '=', 'hnap.form_cirugia.line')]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_form_cirugia_line_group_form_cirugia">
            <field name="model" search="[('model', '=', 'hnap.form_cirugia.line')]"/>
            <field name="group" ref="group_form_cirugia"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="False"/>
        </record>

    </data>
</tryton>
