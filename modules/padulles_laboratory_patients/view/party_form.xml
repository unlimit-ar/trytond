<?xml version="1.0"?>
<data>
    
    <xpath
        expr="/form/group[@id='header']/field[@name='name']"
        position="after">
        <label name="dni"/>
        <field name="dni"/>
    </xpath>
    <xpath
        expr="/form/group[@id='header']/group[@id='checkboxes']/field[@name='active']"
        position="after">
        <label name="patient"/>
        <field name="patient" xexpand="0" width="25"/>
        <label name="laboratory"/>
        <field name="laboratory" xexpand="0" width="25"/>
    </xpath>
</data>
